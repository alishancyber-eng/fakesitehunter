# FakeSite Hunter — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Model file paths ─────────────────────────────────────────
# Root directory for Engine 1 model weights and data
BASE_DIR=/opt/fakesitehunter/models/Engine 1/models

# Path to Engine 2 ML model
E2_ML_MODEL=/opt/fakesitehunter/models/Engine 2/Engine3_ML_Model.pkl

# Path to Engine 2 Tranco domain list
E2_TRANCO_TXT=/opt/fakesitehunter/models/Engine 2/tranco_domains.txt

# Path to Engine 3 EfficientNet weights
E3_CNN_WEIGHTS=/opt/fakesitehunter/models/Engine 3/EfficientNet_B0_Phishing.pth

# ── Website / static files ───────────────────────────────────
# Absolute path to the frontend/ directory on the server
WEBSITE_DIR=/opt/fakesitehunter/website

# ── Database ─────────────────────────────────────────────────
# Path to the SQLite file used for scan stats and visitor counts
STATS_DB_PATH=/opt/fakesitehunter/stats.db

# ── Server ───────────────────────────────────────────────────
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
